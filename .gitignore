# Bundled third-party binaries / runtime - not our source, no meaningful diffs
python/python3/
PIMELauncher.exe
Uninstall.exe
x86/
x64/
python/opencc/*.dll
python/opencc/*.ocd
python/libchewing/*.dll
python/libchewing/data/*.dat
python/libchewing/data/*.tab

# Vendored third-party front-end libraries bundled with chewing's config UI
# pages (bootstrap / jquery / jquery-ui / sweetalert2) - not our code. Only
# relevant if this ever tracks anything under python/input_methods/chewing/
# again; nothing there is currently modified either.
python/input_methods/chewing/css/bootstrap*.css*
python/input_methods/chewing/css/sweetalert2.min.css
python/input_methods/chewing/js/bootstrap*.js*
python/input_methods/chewing/js/jquery-3.6.1.min.js
python/input_methods/chewing/js/jquery-loading-overlay-2.1.7/
python/input_methods/chewing/js/jquery-ui-1.13.2/
python/input_methods/chewing/js/sweetalert2.min.js

# Python bytecode caches - regenerated automatically, not source
__pycache__/
*.pyc

# Claude Code local tool settings - machine/session-specific, not project source
.claude/settings.local.json

# Editor swap files
*.swp

# PIME's shared cinbase engine (code + every cin-based IME's data tables) -
# none of it is modified, it's identical to what the official installer
# provides. cheliu's own additions (v/r/s/f quick-select's prefix check,
# the pinyin reverse-lookup message formatting) are implemented entirely in
# python/input_methods/cheliu/cheliu_ime.py by reading cinbase's public
# attributes (self.cin.chardefs, etc.), so nothing under cinbase/ needs to
# be tracked at all - a fresh official install already provides it.
python/cinbase/
