python/input_methods/chewing/css/sweetalert2.min.css
python/input_methods/chewing/js/bootstrap*.js*
python/input_methods/chewing/js/jquery-3.6.1.min.js
python/input_methods/chewing/js/jquery-loading-overlay-2.1.7/
python/input_methods/chewing/js/jquery-ui-1.13.2/
python/input_methods/chewing/js/sweetalert2.min.js

# Python bytecode caches - regenerated automatically, not source
__pycache__/
*.pyc

# Claude Code local tool settings - machine/session-specific, not project source
.claude/settings.local.json

# Editor swap files
*.swp

# Pristine, unmodified copies of PIME's shared cinbase engine - identical to
# what the official installer provides, so tracking them is redundant.
# cheliu_ime.py no longer needs any cinbase-side additions: the v/r/s/f
# quick-select's prefix check (formerly cinbase/cin.py's hasPrefix()) was
# inlined as a module-level helper operating on the public self.cin.chardefs
# dict instead, so all three files can be untracked.
python/cinbase/__init__.py
python/cinbase/config.py
python/cinbase/cin.py
