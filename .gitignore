python/cinbase/config/js/html5shiv.min.js
python/cinbase/config/js/respond.min.js
python/cinbase/config/js/jquery-1.12.4.min.js
python/cinbase/config/js/jquery.bootstrap-touchspin*.js
python/cinbase/config/js/jAlert/
python/cinbase/config/fonts/
python/cinbase/config/info/
